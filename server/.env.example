# Local development only. On Railway these come from the MySQL plugin
# and the service Variables tab — do not commit a real .env file.

# Railway provides this automatically when MySQL is attached.
MYSQL_URL=mysql://root:password@127.0.0.1:3306/srisai

PORT=4000

# Comma-separated list of allowed origins for the browser.
CORS_ORIGIN=http://localhost:5173
